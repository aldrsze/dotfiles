* {
    bg:         #0a0a0a;
    bg-alt:     #1a1a1a;
    accent:     #ffffff;
    accent-fg:  #0a0a0a;
    fg:         #e0e0e0;
    disabled:   #555555;

    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            520px;
    background-color: @bg;
    border:           0px;
    border-radius:    18px;
}

mainbox {
    spacing:          0px;
    padding:          0px;
    background-color: transparent;
    children:         [ inputbar, listview ];
}

inputbar {
    spacing:          10px;
    padding:          16px 20px;
    background-color: @accent;
    text-color:       @accent-fg;
    border-radius:    18px 18px 0px 0px;
    children:         [ prompt, entry ];
}

prompt {
    enabled:          true;
    background-color: transparent;
    text-color:       @accent-fg;
}

entry {
    background-color:  transparent;
    text-color:        @accent-fg;
    placeholder:        "Search...";
    placeholder-color:  @accent-fg;
}

listview {
    enabled:          true;
    columns:          1;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    spacing:          2px;
    padding:          10px 8px;
    background-color: @bg;
    border-radius:    0px 0px 18px 18px;
}

element {
    enabled:          true;
    padding:          12px 14px;
    background-color: transparent;
    text-color:       @fg;
    border-radius:    10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-alt;
    text-color:       @accent;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
}
